project_id = "customer-prod-project"
region     = "europe-west1"
app_domain = "craftedsignal.example.com"

gke_rbac_security_group = "gke-security-groups@example.com"

master_authorized_networks = [
  {
    cidr = "203.0.113.10/32"
    name = "operator-vpn"
  }
]

enable_confidential_gke_nodes        = false
enable_confidential_space_attestation = false

# When Confidential Space attestation is enabled, restrict the provider to
# approved image digests or image-signing key fingerprints. Leave these empty
# while bootstrapping; production customer KMS grants should set at least one.
confidential_space_allowed_image_digests = [
  # "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
]

confidential_space_signing_key_fingerprints = [
  # "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
]

artifact_registry_writer_members = [
  "principalSet://iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/github-actions/attribute.repository/ORG/REPO",
]

labels = {
  owner = "security-engineering"
}
